# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@db:5432/image_gallery
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=image_gallery

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=images
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Backend
BACKEND_PORT=8000
JWT_SECRET=your-secret-key-change-in-prod
NODE_ENV=development

# Frontend
FRONTEND_PORT=3000
# Used by the browser — must be reachable from the host machine.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Used by Next.js server-side rendering, which runs inside the frontend
# container and reaches the backend over the Docker network, not localhost.
INTERNAL_API_URL=http://backend:8000
FRONTEND_URL=http://localhost:3000